# เลือกผู้ให้บริการ AI: gemini หรือ anthropic
# ถ้าไม่ใส่ ระบบจะเลือกให้เองจาก key ที่มี (ใส่ GEMINI_API_KEY เมื่อไหร่ = สลับไป gemini ทันที)
# AI_PROVIDER=gemini

# Gemini — มีโควตาให้ใช้ฟรี ขอ key ที่ https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash

# Anthropic (ทางเลือกสำรอง) https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# สำหรับ LINE bot เท่านั้น ถ้ารันแค่หน้าเว็บ ปล่อยว่างไว้ได้
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# 1 = ตอบเฉพาะเนื้อหาในโฟลเดอร์ knowledge/ เท่านั้น (ค่าเริ่มต้น)
# 0 = อนุญาตให้ใช้ความรู้ SQL ทั่วไปเสริมได้เมื่อไม่มีในคลัง
STRICT_KNOWLEDGE=1
