# Gemini — ขอ key ฟรีที่ https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite   # ค่าเริ่มต้น เร็วและโควตาเยอะ
# GEMINI_MODEL=gemini-3.5-flash        # ละเอียดกว่า แต่จำกัด 5 คำขอ/นาที

# สำหรับ LINE bot เท่านั้น ถ้ารันแค่หน้าเว็บ ปล่อยว่างไว้ได้
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# 1 = ตอบเฉพาะเนื้อหาในโฟลเดอร์ knowledge/ เท่านั้น (ค่าเริ่มต้น)
# 0 = อนุญาตให้ใช้ความรู้ SQL ทั่วไปเสริมได้เมื่อไม่มีในคลัง
STRICT_KNOWLEDGE=1
